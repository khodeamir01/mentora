<body data-spy="scroll" data-offset="80">
    
    <div class="preloaders"><span class="loader"></span></div>
    <%- include('partials/_headerPage.ejs') %>

<section class="home_bg hb_height" style="background-image: url(/img/bg/home-bg.jpg); background-size:cover; background-position: center center;"><div class="container"><div class="row">
<div class="col-lg-6 col-sm-12 col-xs-12">
    <div class="hero-text ht_top">
        <h1>
        <span> از یادگیری تا درآمد</span><br>مسیر برنامه‌نویس شدن از اینجا شروع میشه</h1>
        <p>دوره‌های پروژه‌محور، منتورینگ تخصصی و پشتیبانی دائمی. مهارتی که امروز یاد میگیری، فردا برات درآمد میسازه.</p>
        </div>
<div class="home_sb">
    <form action="/course" method="GET" class="search-form" onsubmit="if(this.q.value.trim()==''){Swal.fire({icon:'warning',title:'خطا',text:'لطفاً عبارت مورد نظر را وارد کنید'}); return false}">
        <div style="position: relative; display: inline-block; width: 100%;">
            <input type="text" name="search" class="form-control" 
                   placeholder="چی میخوای یاد بگیری؟ جستجو کن..." 
                   style="height: 55px; border-radius: 14px; padding: 0 20px 0 60px; width: 100%; border: 2px solid #e0e0e0; font-size: 15px; transition: all 0.3s; box-shadow: 0 4px 15px rgba(0,0,0,0.05);"
                   onfocus="this.style.borderColor='#525fe1'; this.style.boxShadow='0 4px 20px rgba(82,95,225,0.15)'"
                   onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.05)'">
            <button type="submit" 
                    style="position: absolute; left: 5px; top: 50%; transform: translateY(-50%); width: 42px; height: 42px; background: linear-gradient(135deg, #525fe1, #764ba2); color: white; border: none; border-radius: 10px; cursor: pointer; font-size: 17px; display: flex; align-items: center; justify-content: center; transition: all 0.3s;"
                    onmouseover="this.style.background='linear-gradient(135deg, #764ba2, #525fe1)'"
                    onmouseout="this.style.background='linear-gradient(135deg, #525fe1, #764ba2)'">
                <i class="fa fa-search"></i>
            </button>
        </div>
    </form>
</form>
</div>
<div class="col-lg-6 col-sm-12 col-xs-12"><div class="hero-text-img">
<img src="/img/home-img2.png" class="img-fluid" alt=""><div class="home_ps">
<span class="ti-user"></span><h2><%= totalUsers || 130 %> +</h2>
<p>دانشجوی فعال</p>
</div>
</div></div>
</div></div></section>
<section class="count_area counter_feature">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-book sc_one"></span>
                    <h2 class="counter-num"><%= totalCourses || 130 %></h2>
                    <p>دوره تخصصی</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-user sc_two"></span>
                    <h2 class="counter-num"><%= totalUsers || 130 %></h2>
                    <p>دانشجوی فعال</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-write sc_three"></span>
                    <h2 class="counter-num"><%= totalArticles || 25 %></h2>
                    <p>مقاله آموزشی</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-star sc_four"></span>
                    <h2 class="course-rating counter-style">
                        <%= averageRating ? averageRating.toFixed(1) : "5.0" %>
                    </h2>                   
                    <p>میانگین امتیاز دوره‌ها</p>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="top_cat__area section-padding" style="background-image: url(/img/bg/shape-1.png); background-size:cover; background-position: center center;"><div class="container">
    <div class="section-title text-center">
        <h2>مسیر یادگیری‌ات رو با ما شروع کن</h2>
        <p>از دوره‌های مقدماتی تا پیشرفته، هر چیزی که برای ورود به بازار کار نیاز داری اینجاست. یادگیری رو با پروژه‌های واقعی و مدرسین با تجربه تجربه کن.</p>
        </div>
<div class="row">
    <div class="col-lg-3 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.2s" data-wow-offset="0"><div class="single_tp">
    <span class="sc_one">🧑‍💼</span><h3>اساتید<br>حرفه‌ای</h3>
    <p>دوره‌ها توسط متخصصان باسابقه  تدریس میشن. یادگیری مستقیم از بهترین‌های هر حوزه</p>
    </div></div>
    <div class="col-lg-3 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.3s" data-wow-offset="0"><div class="single_tp">
    <span class="sc_two">🎯</span><h3>یادگیری<br>پروژه‌محور</h3>
    <p>هر دوره شامل پروژه‌های عملی و واقعیست. چیزی که یاد میگیری رو مستقیم توی عمل پیاده میکنی</p>
    </div></div>
    <div class="col-lg-3 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.4s" data-wow-offset="0"><div class="single_tp">
    <span class="sc_three">🎓</span><h3>گواهینامه<br>معتبر</h3>
    <p>بعد از اتمام هر دوره گواهینامه رسمی دریافت کن و رزومه‌ات رو حرفه‌ای‌تر بساز</p>
    </div></div>
    <div class="col-lg-3 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.4s" data-wow-offset="0"><div class="single_tp">
    <span class="sc_four">💬</span><h3>پشتیبانی<br>همیشگی</h3>
    <p>از لحظه ثبت‌نام تا پایان دوره کنارتیم. سوال داری؟ تیم پشتیبانی ۲۴ ساعته پاسخگوست</p>
    </div></div>
    </div>
    </div></section><section class="ab_area section-padding"><div class="container"><div class="row">
    <div class="col-lg-6 col-sm-12 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.2s" data-wow-offset="0"><div class="ab_img"><img src="/img/about1.png" class="img-fluid" alt="image"></div></div>
    <div class="col-lg-6 col-sm-12 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.1s" data-wow-offset="0"><div class="ab_content">
    <h2>مسیر حرفه‌ای شدن از اینجا شروع میشه</h2>
    <p>ما باور داریم آموزش باکیفیت باید در دسترس همه باشه. منتورا پلی هست بین تو و مهارت‌هایی که برای موفقیت توی دنیای واقعی نیاز داری.</p>
    <p>با بیش از ۱۳۰ دوره تخصصی در زمینه برنامه‌نویسی، طراحی، بازاریابی دیجیتال و کسب‌وکار، مسیر یادگیری‌ات رو با خیال راحت شروع کن.</p>
    <ul>
    <li><span class="ti-check"></span>دسترسی به <b>۱۳۰+</b> دوره تخصصی و پروژه‌محور</li>
    <li><span class="ti-check"></span>یادگیری با جدیدترین متدهای روز دنیا</li>
    <li><span class="ti-check"></span>پشتیبانی و منتورینگ در تمام مسیر یادگیری</li>
    </ul>
    <a class="btn_one" href="/course">مشاهده همه دوره ها<i class="ti-arrow-top-left"></i></a>
    </div></div>
</div></div></section><section class="top_cat__area section-padding" style="background-image: url(/img/bg/section-2.jpg); background-size:cover; background-position: center center;"><div class="container">
    <div class="section-title text-center">
        <h2>دسته‌بندی‌های محبوب</h2>
        <p>از برنامه‌نویسی و طراحی گرفته تا بازاریابی و کسب‌وکار، هر مهارتی که به دنبالشی توی دسته‌بندی‌های ما پیدا می‌کنی.</p>
        </div>
        <div class="row">
            <div class="col-lg-12 col-sm-12 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.1s" data-wow-offset="0">
                <div class="cat_list">
                    <ul>
                        <% if (categories && categories.length > 0) { %>
                            <% categories.forEach(cat => { %>
                                <li>
                                    <a href="/course?category=<%= cat._id %>">
                                        <span class="cat-icon">
                                            <% 
                                                const title = (cat.title || '').toLowerCase();
                                                if (title.includes('front') || title.includes('فرانت')) { %>
                                                    <i class="fa fa-desktop"></i>
                                                <% } else if (title.includes('back') || title.includes('بک')) { %>
                                                    <i class="fa fa-server"></i>
                                                <% } else if (title.includes('security') || title.includes('امنیت')) { %>
                                                    <i class="fa fa-shield"></i>
                                                <% } else if (title.includes('network') || title.includes('شبکه')) { %>
                                                    <i class="fa fa-sitemap"></i>
                                                <% } else if (title.includes('desktop') || title.includes('دسکتاپ')) { %>
                                                    <i class="fa fa-laptop"></i>
                                                <% } else if (title.includes('mobile') || title.includes('موبایل')) { %>
                                                    <i class="fa fa-mobile"></i>
                                                <% } else if (title.includes('devops') || title.includes('دیوآپس')) { %>
                                                    <i class="fa fa-cogs"></i>
                                                <% } else { %>
                                                    <i class="fa fa-folder"></i>
                                                <% } %>
                                        </span>
                                        <%= cat.title %>
                                    </a>
                                </li>
                            <% }); %>
                        <% } %>
                    </ul>
                </div>
            </div>
        </div>
<section class="home_course section-padding">
    <div class="container">
        <!-- بخش عنوان و دکمه مشاهده همه -->
        <div class="row">
            <div class="col-lg-8 col-sm-6 col-xs-12">
                <div class="section-title">
                    <h2>با بیش از <b><%= locals.totalCourses || '0' %>+</b><br>دوره و آموزش</h2>
                </div>
            </div>
            <div class="col-lg-4 col-sm-6 col-xs-12">
                <div class="cour_btn">
                    <a href="/course" class="btn_one">مشاهده تمام دوره ها<i class="ti-arrow-top-left"></i></a>
                </div>
            </div>
        </div>

<!-- بخش لیست دوره‌ها -->
<div class="row">
    <% if (locals.courses && courses.length > 0) { %>
  
        <% courses.forEach(function(course) { %>
            <div class="col-lg-4 col-sm-6 col-xs-12">
                <div class="single_course">
                    <div class="single_c_img">
                        <div class="course-cover-wrapper">
                            <img src="/img/course/<%= course.cover || '1.png' %>" 
                                 class="course-cover-img" 
                                 alt="<%= course.name %>"
                                 loading="lazy"
                                 onerror="this.src='/img/course/1.png'">
                        </div>
                        <span class="category-tag">
                            <% if (course.categoryID) { %>
                                <a href="/categories/<%= course.categoryID.href %>" class="category-link">
                                    <%= course.categoryID.title %>
                                </a>
                            <% } else { %>
                                <span class="category-link">بدون دسته</span>
                            <% } %>
                        </span>
                    </div>
  
                    <!-- ستاره‌ها بر اساس میانگین rating -->
                    <div class="ratings" style="display: flex; justify-content: center; align-items: center; gap: 2px; margin: 8px 0;">
                        <% 
                            const avgRating = course.avgRating || 0;
                            for (let i = 1; i <= 5; i++) { 
                        %>
                            <i class="fa fa-star<%= i <= avgRating ? '' : '-o' %>" 
                               style="color: <%= i <= avgRating ? '#FFD700' : '#ccc' %>"></i>
                        <% } %>
                        <small style="color: #888;">امتیاز</small>
                    </div>
  
                    <h4><a href="/course/<%= course.href %>"><%= course.name %></a></h4>
  
                    <p><span class="ti-book"></span> <%= course.sessionCount || 0 %> </p> جلسه
                    <p><span class="ti-alarm-clock"></span><%= course.duration || '2 ساعت و 32 دقیقه' %></p>
  
                    <div class="price">
                        <% if (course.price === 0) { %>
                            هزینه دوره - رایگان
                        <% } else { %>
                            هزینه دوره - <%= course.price.toLocaleString() %> تومان
                        <% } %>
                    </div>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="col-12 text-center">
            <p>در حال حاضر دوره‌ای برای نمایش وجود ندارد.</p>
        </div>
    <% } %>
</div>
    </div>
</section>
<div class="partner-logo section-padding"><div class="container"><div class="row part_bg">
<div class="col-lg-4 col-sm-4 col-xs-12"><div class="partner_title"><h3><span>860+ </span>شرکت در سراسر جهان به ما اعتماد کردند</h3></div></div>
<div class="col-lg-8 col-sm-8 col-xs-12 text-center"><div class="partner">
<a href="#"><img src="/img/clients/1.png" alt="image"></a><a href="#"><img src="/img/clients/2.png" alt="image"></a><a href="#"><img src="/img/clients/3.png" alt="image"></a><a href="#"><img src="/img/clients/4.png" alt="image"></a><a href="#"><img src="/img/clients/5.png" alt="image"></a><a href="#"><img src="/img/clients/2.png" alt="image"></a><a href="#"><img src="/img/clients/1.png" alt="image"></a><a href="#"><img src="/img/clients/3.png" alt="image"></a><a href="#"><img src="/img/clients/4.png" alt="image"></a>
</div></div>
</div></div></div>
<section class="team_area section-padding"><div class="container">
    <div class="section-title text-center">
        <h2>با مدرسین ما آشنا شوید</h2>
        <p>یادگیری از کسانی که خودشون مسیر رو طی کردن، همیشه نتیجه بهتری داره. مدرسین ما ترکیبی از دانش فنی و تجربه واقعی بازار کار رو بهت منتقل می‌کنن.</p>
        </div>
<div class="row">
<div class="row" style="display: flex; flex-wrap: wrap;">
    <% if (teachers && teachers.length > 0) { %>
        <% teachers.slice(0, 3).forEach(teacher => { %>
            <div class="col-lg-4 col-sm-6 col-xs-12 wow fadeInUp" style="display: flex; margin-bottom: 30px;">
                <div class="our-team" style="width: 100%; display: flex; flex-direction: column; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 25px rgba(0,0,0,0.08); transition: all 0.3s;">
                    <div class="team-content" style="height: 220px; overflow: hidden;">
                        <a href="/teachers/<%= teacher._id %>">
                            <img src="<%= teacher.avatar || '/img/team/default.jpg' %>" alt="<%= teacher.name %>" style="width: 100%; height: 160%; object-fit: cover;">
                        </a>
                        <ul class="social-links">
                            <li><a href="#" class="ti-twitter"></a></li>
                            <li><a href="#" class="ti-linkedin"></a></li>
                            <li><a href="#" class="ti-facebook"></a></li>
                        </ul>
                    </div>
                    <div class="team-prof" style="flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 20px 15px 10px;">
                        <h3 style="font-size: 18px; font-weight: 700; min-height: 28px;"><%= teacher.name %></h3>
                        <span style="color: #888; font-size: 13px; min-height: 22px;"><%= teacher.bio?.substring(0, 50) || 'مدرس' %></span>
                    </div>
                    <div class="sth_det2" style="display: flex; justify-content: center; gap: 20px; padding: 10px 15px 20px; border-top: 1px solid #eee;">
                        <span><i class="fa fa-play-circle"></i> <%= teacher.courseCount || 0 %> دوره</span>
                        <span><i class="fa fa-users"></i> <%= teacher.studentCount || 0 %> دانشجو</span>
                    </div>
                </div>
            </div>
        <% }); %>
    <% } %>
</div>

    <div style="text-align: center; margin-top: 20px;">
        <a href="/teachers" class="btn_one" style="display: inline-block;">
            مشاهده همه مدرسین <i class="ti-arrow-left"></i>
        </a>
    </div>

</div>
</div></section><section class="ab_area section-padding"><div class="container"><div class="row">
    <div class="col-lg-6 col-sm-12 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.1s" data-wow-offset="0"><div class="ab_content">

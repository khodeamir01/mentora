<div class="col-lg-6 col-sm-12 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.2s" data-wow-offset="0"><div class="ab_img">
<img src="/img/about3.png" class="img-fluid" alt="image"><div class="home_ps2">
<span class="ti-book"></span><h2>3300+</h2>
<p>دوره آنلاین</p>
</div>
</div></div>
</div></div></section>
<section class="testi_area section-padding">
    <div class="container">
        <div class="section-title">
            <h2>دانشجویان ما چی میگن؟</h2>
        </div>
        <div class="row">
            <div class="col-lg-6 col-sm-12 col-xs-12">

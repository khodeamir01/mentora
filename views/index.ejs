<!-- ========== مقالات - همه یک‌اندازه ========== -->
<div class="row" style="display: flex; flex-wrap: wrap;">
    <% if (articles && articles.length > 0) { %>
        <% articles.forEach(function(article) { %>
            <div class="col-lg-4 col-sm-6 col-xs-12 wow fadeInUp" style="display: flex; margin-bottom: 30px;">
                <div class="single_blog" style="width: 100%; display: flex; flex-direction: column; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 25px rgba(0,0,0,0.06);">
                    <div style="height: 200px; overflow: hidden;">
                        <img src="<%= article.cover || '/img/blog/blog-1.png' %>" alt="<%= article.title %>" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                    <div class="content_box" style="flex: 1; display: flex; flex-direction: column; padding: 20px;">
                        <span style="font-size: 12px; color: #888;">
                            <%= new Date(article.createdAt).toLocaleDateString('fa-IR', { day: 'numeric', month: 'long', year: 'numeric' }) %> |
                            <a href="/articles?category=<%= article.category._id %>" style="color: #525fe1;">
                                <%= article.category?.title || 'مقالات' %>
                            </a>
                        </span>
                        <h2 style="font-size: 17px; margin: 10px 0; min-height: 50px; line-height: 1.5;">
                            <a href="/articles/<%= article.slug %>" style="color: #1a2d62;"><%= article.title %></a>
                        </h2>
                        <p style="color: #666; font-size: 13px; flex: 1;">
                            <%= article.description?.substring(0, 80) %>...
                        </p>
                        <a class="btn_one" href="/articles/<%= article.slug %>" style="margin-top: auto; text-align: center;">
                            ادامه مطلب <i class="ti-arrow-top-left"></i>
                        </a>
                    </div>
                </div>
            </div>
        <% }); %>
    <% } %>
</div>

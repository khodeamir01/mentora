                        }).then(() => {
                            window.location.href = '/';
                        });
                    })
                    .catch(() => {
                        window.location.href = '/';
                    });
            }
        });
    });
    

let currentSlide = 0;
const slides = document.querySelectorAll('#testimonial-slider .testimonial');
const dotsContainer = document.getElementById('slideDots');

if (slides.length > 0) {

    slides.forEach((_, i) => {
        const dot = document.createElement('span');
        dot.style.cssText = `width: 10px; height: 10px; border-radius: 50%; background: ${i === 0 ? '#525fe1' : '#ddd'}; cursor: pointer; transition: all 0.3s; display: inline-block;`;
        dot.onclick = () => { currentSlide = i; updateSlide(); };
        dotsContainer.appendChild(dot);
    });
    
    const dots = dotsContainer.querySelectorAll('span');
    
    function updateSlide() {
    slides.forEach((s, i) => {
        s.style.display = i === currentSlide ? 'block' : 'none';
        if (i === currentSlide) {
            s.style.animation = 'none';
            s.offsetHeight; // reflow
            s.style.animation = 'slideFadeIn 0.5s ease';
        }
    });
    dots.forEach((d, i) => d.className = 'slider-dot ' + (i === currentSlide ? 'active' : ''));
}
    
    function nextSlide() {
        currentSlide = (currentSlide + 1) % slides.length;
        updateSlide();
    }
    
    function prevSlide() {
        currentSlide = (currentSlide - 1 + slides.length) % slides.length;
        updateSlide();
    }
    
    setInterval(nextSlide, 4000);
}

document.querySelectorAll('.mobile_menu > li > a').forEach(function(link) {
    link.addEventListener('click', function(e) {
        var subMenu = this.parentElement.querySelector('.sub-menu');
        if (subMenu) {
            e.preventDefault();
            this.parentElement.classList.toggle('open');
        }
    });
});

    </script>
    


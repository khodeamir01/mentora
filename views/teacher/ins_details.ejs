<!DOCTYPE html>
<html dir="rtl" lang="fa">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= teacher.name %> - مدرس منتورا</title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/fonts/font-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inria+Sans:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .teacher-hero {
            background: linear-gradient(135deg, #1a1a2e 0%, #302b63 100%);
            padding: 80px 0 50px;
            position: relative;
            overflow: hidden;
        }
        .teacher-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(102,126,234,0.1) 0%, transparent 70%);
            animation: rotate 30s linear infinite;
        }
        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .teacher-profile {
            position: relative;
            z-index: 1;
            text-align: center;
            color: white;
        }
        .teacher-avatar {
            width: 160px;
            height: 160px;
            border-radius: 50%;
            border: 5px solid rgba(255,255,255,0.2);
            object-fit: cover;
            box-shadow: 0 15px 40px rgba(0,0,0,0.3);
            margin-bottom: 20px;
        }
        .teacher-name {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 8px;
            color:  #f8f9fb;
        }
        .teacher-role {
            display: inline-block;
            background: rgba(255,255,255,0.15);
            padding: 8px 24px;
            border-radius: 30px;
            font-size: 14px;
            border: 1px solid rgba(255,255,255,0.2);
        }
        .teacher-bio {
            max-width: 600px;
            margin: 20px auto 0;
            opacity: 0.85;
            line-height: 2;
        }
        .stats-row {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-top: 30px;
            flex-wrap: wrap;
        }
        .stat-item {
            text-align: center;
            background: rgba(255,255,255,0.08);
            padding: 15px 25px;
            border-radius: 16px;
            min-width: 100px;
        }
        .stat-item .num {
            font-size: 24px;
            font-weight: 700;
        }
        .stat-item .lbl {
            font-size: 12px;
            opacity: 0.7;
            margin-top: 4px;
        }
        .courses-section {
            padding: 60px 0;
            background: #f8f9fb;
        }
        .course-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
            transition: all 0.3s;
            margin-bottom: 30px;
        }
        .course-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.12);
        }
        .course-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }
        .course-card-body {
            padding: 20px;
            text-align: center;
        }
        .course-card-body h4 {
            font-size: 18px;
            margin-bottom: 10px;
        }
        .course-card-body h4 a {
            color: #1a1a2e;
            text-decoration: none;
        }
        .course-price {
            color: #525fe1;
            font-weight: 700;
            font-size: 18px;
        }
        .empty-courses {
            text-align: center;
            padding: 60px;
            color: #999;
        }
        .empty-courses i {
            font-size: 50px;
            display: block;
            margin-bottom: 15px;
            color: #ddd;
        }
    </style>
</head>
<body>

<!-- views/partials/_header.ejs -->
<div id="navigation" class="navbar-light bg-faded site-navigation">
    <div class="container-fluid">
        <div class="row">
            <div class="col-20 align-self-center">
                <div class="site-logo">
                    <a href="/"><img src="/img/logoMentora.png" alt="">
                      <span class="footer-title" style="top: 10px;">Mentora</span>
                  </a>
                  </div>
            </div>
            <div class="col-60 d-flex">
                <nav id="main-menu">
                    <ul>
                        <li><a href="/">صفحه اصلی</a></li>
                        <li><a href="/about">درباره</a></li>
                        <li><a href="/course">دوره‌ها</a></li>
                        <li><a href="/teachers">مدرسین</a></li>
                        <li><a href="/articles">مقالات</a></li>
                        <li><a href="/contact">تماس</a></li>
                    </ul>
                </nav>
            </div>
            <div class="col-20 d-none d-xl-block text-end align-self-center">
                <% if (user) { %>
                    <div class="user-dropdown">
                        <button class="user-dropdown-btn" onclick="toggleUserMenu()">
                            <img src="<%= user.avatar ?  user.avatar : '/img/avatar/defualtPic.png' %>" 
                                 alt="<%= user.name %>" class="user-avatar-small">
                            <span><%= user.name %></span>
                            <i class="fa fa-angle-down"></i>
                        </button>
                        <div class="user-dropdown-menu" id="userMenu">
                            <div class="dropdown-header">
                                <strong><%= user.name %></strong>
                                <small><%= user.email %></small>
                            </div>
                            
                            <% 
                                let dashboardLink = '/dashboard/user';
                                if (user.roles.includes('ADMIN')) dashboardLink = '/dashboard/admin';
                                else if (user.roles.includes('AUTHOR')) dashboardLink = '/dashboard/author';
                                else if (user.roles.includes('TEACHER')) dashboardLink = '/dashboard/teacher';
                            %>
                            
                            <a href="<%= dashboardLink %>"><i class="fa fa-tachometer"></i> پنل کاربری</a>
                            <a href="/cart"><i class="fa fa-shopping-cart"></i> سبد خرید</a>
                            
                            <% if (user.roles.includes('ADMIN')) { %>
                                <a href="/dashboard/admin/users"><i class="fa fa-users"></i> مدیریت کاربران</a>
                            <% } %>
                            
                            <% if (user.roles.includes('AUTHOR')) { %>
                                <a href="/articles/create"><i class="fa fa-pencil"></i> مقاله جدید</a>
                            <% } %>
                            
                            <div class="dropdown-divider"></div>
                            <a href="#" class="logout-link" style="color: #ff6b6b;">
                                <i class="fa fa-sign-out"></i> خروج
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/auth/login" class="header-btn">ورود</a>
                    <a href="/auth/register" class="btn_one">ثبت نام</a>
                <% } %>
              </div>
        </div>
    </div>
</div>
<section class="teacher-hero">
    <div class="container">
        <div class="teacher-profile">
            <img src="<%= teacher.avatar || '/img/avatar/defualtPic.png' %>" alt="<%= teacher.name %>" class="teacher-avatar">
            <h1 class="teacher-name"><%= teacher.name %></h1>
            <span class="teacher-role"><i class="fa fa-graduation-cap"></i> مدرس</span>
            <% if (teacher.bio) { %>
                <p class="teacher-bio"><%= teacher.bio %></p>
            <% } %>
            <div class="stats-row">
                <div class="stat-item">
                    <div class="num"><%= courses.length %></div>
                    <div class="lbl">دوره</div>
                </div>
                <div class="stat-item">
                    <div class="num"><%= totalSessions || 0 %></div>
                    <div class="lbl">جلسه</div>
                </div>
                <div class="stat-item">
                    <div class="num"><%= averageRating || '۴.۸' %></div>
                    <div class="lbl">امتیاز</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="courses-section">
    <div class="container">
        <div class="section-title text-center">
            <h2>دوره‌های <%= teacher.name %></h2>
        </div>
        
        <% if (courses.length > 0) { %>
            <div class="row">
                <% courses.forEach(course => { %>
                    <div class="col-lg-4 col-sm-6 col-xs-12">
                        <div class="course-card">
                            <img src="/img/cover/<%= course.cover || '1.png' %>" alt="<%= course.name %>">
                            <div class="course-card-body">
                                <h4><a href="/course/<%= course.href %>"><%= course.name %></a></h4>
                                <div class="course-price">
                                    <% if (course.price === 0) { %>
                                        رایگان
                                    <% } else { %>
                                        <%= course.price.toLocaleString() %> تومان
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="empty-courses">
                <i class="fa fa-book"></i>
                <p>هنوز دوره‌ای منتشر نشده</p>
            </div>
        <% } %>
    </div>
</section>

<%- include('../partials/_footer') %>

</body>
</html>
<!DOCTYPE html>
<html dir="rtl" lang="fa">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>پنل مدرس - <%= user.name %></title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/fonts/font-awesome.min.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <script src="/js/sweetAlert2.js"></script>
    <style>
        .glass-header {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
            border: none;
            color: white;
            border-radius: 24px;
            padding: 35px 40px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }
        .glass-header h2 { color: white; }
        .glass-header h2 i { color: #38bdf8; }
        .header-subtitle { color: rgba(255,255,255,0.8); }
        
        .stats-grid {
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }
        
        .stat-card {
            border-radius: 20px;
            padding: 28px;
            border: 1px solid #f1f5f9;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }
        .stat-icon {
            width: 50px;
            height: 50px;
            border-radius: 16px;
            font-size: 22px;
        }
        .card-blue .stat-icon { background: #eff6ff; color: #3b82f6; }
        .card-blue .stat-number { color: #3b82f6; }
        .card-blue { border-top: 4px solid #3b82f6; }
        
        .card-green .stat-icon { background: #f0fdf4; color: #22c55e; }
        .card-green .stat-number { color: #22c55e; }
        .card-green { border-top: 4px solid #22c55e; }
        
        .card-purple .stat-icon { background: #faf5ff; color: #a855f7; }
        .card-purple .stat-number { color: #a855f7; }
        .card-purple { border-top: 4px solid #a855f7; }
        
        .card-orange .stat-icon { background: #fff7ed; color: #f97316; }
        .card-orange .stat-number { color: #f97316; }
        .card-orange { border-top: 4px solid #f97316; }
        
        .content-card {
            border-radius: 20px;
            border: 1px solid #f1f5f9;
            padding: 32px;
            margin-bottom: 28px;
        }
        
        .card-title {
            font-size: 19px;
            padding-bottom: 18px;
            margin-bottom: 24px;
        }
        .card-title i {
            background: #eff6ff;
            color: #3b82f6;
            padding: 8px;
            border-radius: 10px;
        }
        
        .table thead { background: linear-gradient(135deg, #f8fafc, #f1f5f9); }
        .table th {
            padding: 16px 18px;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #64748b;
            font-weight: 700;
        }
        .table td { padding: 18px; border-bottom: 1px solid #f8fafc; }
        .table tbody tr:hover { background: #fafbfe; box-shadow: 0 4px 15px rgba(0,0,0,0.04); border-radius: 12px; }
        
        .badge-free { background: #dcfce7; color: #15803d; padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; }
        .badge-paid { background: #fff7ed; color: #c2410c; padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; }
        
        .btn-dashboard.btn-primary-dash {
            background: #3b82f6;
            border-radius: 12px;
            padding: 9px 20px;
            font-size: 13px;
        }
        .btn-dashboard.btn-primary-dash:hover { background: #2563eb; box-shadow: 0 8px 20px rgba(59,130,246,0.3); }
        .btn-sm { padding: 7px 16px; font-size: 12px; border-radius: 10px; }
        
        .empty-state {
            padding: 60px;
            background: #fafbfe;
            border-radius: 16px;
            text-align: center;
        }
        .empty-state i {
            font-size: 60px;
            background: #f1f5f9;
            width: 90px;
            height: 90px;
            line-height: 90px;
            border-radius: 50%;
            margin: 0 auto 20px;
            color: #94a3b8;
        }
        
        .header-actions .date { color: rgba(255,255,255,0.7); font-size: 13px; }
        
        @media (max-width: 768px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .glass-header { padding: 25px; }
            .content-card { padding: 20px; }
        }
        @media (max-width: 480px) {
            .stats-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
<div class="dashboard-layout">
    
    <%- include('../partials/_sidebar') %>

    <main class="main-content">
        
        <div class="page-header glass-header">
            <div>
                <h2><i class="fa fa-graduation-cap"></i> پنل مدرس</h2>
                <p class="header-subtitle">
                    <%= user.name %> عزیز، به پنل تدریس خود خوش آمدید
                </p>
            </div>
            <div class="header-actions">
                <span class="date"><i class="fa fa-calendar"></i> <%= new Date().toLocaleDateString('fa-IR') %></span>
            </div>
        </div>
        

        <!-- آمار -->
        <div class="stats-grid">
            <div class="stat-card card-blue">
                <div class="stat-top">
                    <div class="stat-icon"><i class="fa fa-book"></i></div>
                    <div class="stat-number"><%= myCourses.length %></div>
                </div>
                <div class="stat-label">دوره‌های من</div>
            </div>
            <div class="stat-card card-green">
                <div class="stat-top">
                    <div class="stat-icon"><i class="fa fa-video-camera"></i></div>
                    <div class="stat-number"><%= totalSessions %></div>
                </div>
                <div class="stat-label">کل جلسات</div>
            </div>
            <div class="stat-card card-purple">
                <div class="stat-top">
                    <div class="stat-icon"><i class="fa fa-users"></i></div>
                    <div class="stat-number"><%= totalStudents %></div>
                </div>
                <div class="stat-label">دانشجویان</div>
            </div>
            <div class="stat-card card-orange">
                <div class="stat-top">
                    <div class="stat-icon"><i class="fa fa-comments"></i></div>
                    <div class="stat-number"><%= totalComments %></div>
                </div>
                <div class="stat-label">کامنت‌ها</div>
            </div>
        </div>

        <!-- دوره‌های من -->
        <div class="content-card">
            <h5 class="card-title"><i class="fa fa-book"></i> دوره‌های من</h5>
            
            <% if (myCourses.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>دوره</th>
                                <th>وضعیت</th>
                                <th>قیمت</th>
                                <th>جلسات</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% myCourses.forEach((course, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 12px;">
                                            <img src="/img/cover/<%= course.cover || 'default.jpg' %>" 
                                                 style="width: 50px; height: 50px; border-radius: 10px; object-fit: cover;">
                                            <div>
                                                <strong><%= course.name %></strong>
                                                <br><small style="color: #888;"><%= course.href %></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge-<%= course.status === 'published' ? 'free' : 'paid' %>">
                                            <%= course.status === 'published' ? 'منتشر شده' : 'پیش‌نویس' %>
                                        </span>
                                    </td>
                                    <td><%= course.price === 0 ? 'رایگان' : course.price.toLocaleString() + ' تومان' %></td>
                                    <td><%= course.sessionCount || 0 %> جلسه</td>
                                    <td>
                                        <a href="/course/<%= course._id %>/sessions/create" class="btn-dashboard btn-primary-dash btn-sm">
                                            <i class="fa fa-plus"></i> جلسه جدید
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="fa fa-book"></i>
                    <p>هنوز دوره‌ای ایجاد نکرده‌اید</p>
                </div>
            <% } %>
        </div>

        <!-- آخرین جلسات -->
        <div class="content-card">
            <h5 class="card-title"><i class="fa fa-video-camera"></i> آخرین جلسات</h5>
            
            <% if (mySessions.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>دوره</th>
                                <th>جلسه</th>
                                <th>وضعیت</th>
                                <th>تاریخ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% mySessions.forEach(session => { %>
                                <tr>
                                    <td><%= session.course?.name || '---' %></td>
                                    <td>
                                        <strong><%= session.title %></strong>
                                        <br><small style="color: #888;">جلسه <%= session.order %></small>
                                    </td>
                                    <td>
                                        <span class="badge-<%= session.isFree ? 'free' : 'paid' %>">
                                            <%= session.isFree ? 'رایگان' : 'نقدی' %>
                                        </span>
                                    </td>
                                    <td><small style="color: #888;"><%= new Date(session.createdAt).toLocaleDateString('fa-IR') %></small></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="fa fa-video-camera"></i>
                    <p>هنوز جلسه‌ای ایجاد نکرده‌اید</p>
                </div>
            <% } %>
        </div>

    </main>
</div>
</body>
</html>
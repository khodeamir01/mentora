<!DOCTYPE html>
<html dir="rtl" lang="fa">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>پنل نویسنده - <%= user.name %></title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/fonts/font-awesome.min.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <script src="/js/sweetAlert2.js"></script>
</head>
<body>
    <div class="dashboard-layout dashboard-section">
    
    <%- include('../partials/_sidebar') %>

    <main class="main-content">
        
        <div class="page-header glass-header">
            <div>
                <h2>
                    <i class="fa fa-pencil-square-o"></i>
                    پنل نویسنده
                </h2>
                <p class="header-subtitle">
                    مدیریت مقالات، آمار و پیش‌نویس‌های شما
                </p>
            </div>
        
            <div class="header-actions">
                <span class="date">
                    <i class="fa fa-calendar"></i>
                    <%= new Date().toLocaleDateString('fa-IR') %>
                </span>
        
                <a href="/articles/create" class="btn-dashboard btn-primary-dash">
                    <i class="fa fa-plus"></i>
                    مقاله جدید
                </a>
            </div>
        </div>

        <!-- آمار -->
<!-- Chart.js -->

<div class="dashboard-wrap">

    <div class="dashboard-header">
        <div>
            <h2 class="dashboard-title">داشبورد مقالات</h2>
            <p class="dashboard-subtitle">نمای کلی از وضعیت مقاله‌ها، انتشار و بازدیدها</p>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card blue">
            <div class="stat-top">
                <div class="stat-icon">
                    <i class="fa fa-file-text"></i>
                </div>
                <div class="stat-number"><%= myArticles.length %></div>
            </div>
            <div class="stat-label">کل مقالات</div>
            <div class="progress-line"></div>
        </div>

        <div class="stat-card green">
            <div class="stat-top">
                <div class="stat-icon">
                    <i class="fa fa-check-circle"></i>
                </div>
                <div class="stat-number"><%= myArticles.filter(a => a.status === 'published').length %></div>
            </div>
            <div class="stat-label">منتشر شده</div>
            <div class="progress-line"></div>
        </div>

        <div class="stat-card orange">
            <div class="stat-top">
                <div class="stat-icon">
                    <i class="fa fa-edit"></i>
                </div>
                <div class="stat-number"><%= myArticles.filter(a => a.status === 'draft').length %></div>
            </div>
            <div class="stat-label">پیش‌نویس</div>
            <div class="progress-line"></div>
        </div>

        <div class="stat-card teal">
            <div class="stat-top">
                <div class="stat-icon">
                    <i class="fa fa-eye"></i>
                </div>
                <div class="stat-number"><%= myArticles.reduce((sum, a) => sum + (a.views || 0), 0) %></div>
            </div>
            <div class="stat-label">بازدید کل</div>
            <div class="progress-line"></div>
        </div>
    </div>

    <div class="charts-grid">
        <div class="chart-card">
            <div class="chart-card-header">
                <h3>وضعیت مقالات</h3>
                <span>Published / Draft</span>
            </div>
            <div class="chart-box">
                <canvas id="statusChart"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <div class="chart-card-header">
                <h3>بازدید مقالات</h3>
                <span>Views per Article</span>
            </div>
            <div class="chart-box">
                <canvas id="viewsChart"></canvas>
            </div>
        </div>
    </div>

</div>




        <!-- لیست مقالات -->
        <div class="content-card">
            <h5 class="card-title"><i class="fa fa-list"></i> مقالات من</h5>
            
            <% if (myArticles.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>عنوان</th>
                                <th>وضعیت</th>
                                <th>بازدید</th>
                                <th>تاریخ</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% myArticles.forEach((article, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 10px;">
                                            <img src="/img/blog/<%= article.cover || '/img/blog/default.jpg' %>" 
                                                 style="width: 50px; height: 50px; border-radius: 8px; object-fit: cover;">
                                            <div>
                                                <div class="article-title">
                                                    <%= article.title %>
                                                </div>
                                                
                                                <div class="article-slug">
                                                    /<%= article.slug %>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <% if (article.status === 'published') { %>
                                            <span class="badge badge-success">منتشر شده</span>
                                        <% } else { %>
                                            <span class="badge badge-warning">پیش‌نویس</span>
                                        <% } %>
                                    </td>
                                    <td><%= article.category?.title || 'بدون دسته' %></td>
                                    <td>
                                        <i class="fa fa-eye" style="color: #ccc;"></i> <%= article.views || 0 %>
                                    </td>
                                    <td>
                                        <small style="color: #888;">
                                            <%= new Date(article.createdAt).toLocaleDateString('fa-IR') %>
                                        </small>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <% if (article.status === 'published') { %>
                                                <a href="/articles/<%= article.slug %>" 
                                                   class="btn-icon btn-icon-info" target="_blank" title="مشاهده">
                                                    <i class="fa fa-eye"></i>
                                                </a>
                                            <% } %>
                                            <a href="/articles/edit/<%= article._id %>" 
                                                class="btn-icon btn-icon-info" title="ویرایش">
                                                 <i class="fa fa-edit"></i>
                                             </a>
                                            <button onclick="deleteArticle('<%= article._id %>')" 
                                                    class="btn-icon btn-icon-ban" title="حذف">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">

                    <i class="fa fa-pencil-square-o"></i>
                    
                    <h3>اولین مقاله‌ات رو بنویس 🚀</h3>
                    
                    <p>
                    هنوز مقاله‌ای ثبت نکرده‌ای.
                    </p>
                    
                    <a href="/articles/create"
                    class="btn-dashboard btn-primary-dash">
                    
                    نوشتن مقاله
                    
                    </a>
                    
                    </div>
            <% } %>
        </div>

    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    async function deleteArticle(id) {
    const result = await Swal.fire({
        title: 'حذف مقاله',
        text: 'آیا مطمئن هستید؟ این عملیات قابل بازگشت نیست',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'بله، حذف کن',
        cancelButtonText: 'انصراف',
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        reverseButtons: true
    });

    if (!result.isConfirmed) return;

    Swal.fire({
        title: 'در حال حذف...',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
    });

    try {
        const res = await fetch(`/articles/${id}`, { method: 'DELETE' });
        const data = await res.json();

        if (data.success) {
            Swal.fire({
                icon: 'success',
                title: 'حذف شد!',
                text: data.message,
                timer: 2000,
                showConfirmButton: false
            }).then(() => location.reload());
        } else {
            Swal.fire({
                icon: 'error',
                title: 'خطا',
                text: data.error
            });
        }
    } catch (error) {
        Swal.fire({
            icon: 'error',
            title: 'خطا',
            text: 'خطا در ارتباط با سرور'
        });
    }
}
const articles = JSON.parse('<%- JSON.stringify(myArticles).replace(/\\/g, "\\\\").replace(/'/g, "\\'") %>')


    const publishedCount = articles.filter(a => a.status === 'published').length;
    const draftCount = articles.filter(a => a.status === 'draft').length;
    const totalViews = articles.reduce((sum, a) => sum + (a.views || 0), 0);

    // Doughnut Chart - Status
    const statusCtx = document.getElementById('statusChart').getContext('2d');
    new Chart(statusCtx, {
        type: 'doughnut',
        data: {
            labels: ['منتشر شده', 'پیش‌نویس'],
            datasets: [{
                data: [publishedCount, draftCount],
                backgroundColor: ['#22c55e', '#f59e0b'],
                borderColor: ['#ffffff', '#ffffff'],
                borderWidth: 3,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '68%',
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        usePointStyle: true,
                        pointStyle: 'circle',
                        padding: 20,
                        font: {
                            family: 'IRANSans, Vazirmatn, sans-serif',
                            size: 13
                        }
                    }
                },
                tooltip: {
                    bodyFont: {
                        family: 'IRANSans, Vazirmatn, sans-serif'
                    },
                    titleFont: {
                        family: 'IRANSans, Vazirmatn, sans-serif'
                    }
                }
            }
        }
    });

    // Bar Chart - Views (با ستون‌های باریک)
    const viewsCtx = document.getElementById('viewsChart').getContext('2d');

    const labels = articles.slice(0, 8).map((a, index) => {
        const title = a.title || `مقاله ${index + 1}`;
        return title.length > 14 ? title.substring(0, 14) + '…' : title;
    });

    const viewsData = articles.slice(0, 8).map(a => a.views || 0);

    new Chart(viewsCtx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'بازدید',
                data: viewsData,
                backgroundColor: [
                    '#38bdf8',
                    '#60a5fa',
                    '#818cf8',
                    '#a78bfa',
                    '#22d3ee',
                    '#34d399',
                    '#f59e0b',
                    '#fb7185'
                ],
                borderRadius: 6,
                borderSkipped: false,
                barPercentage: 0.4,        // ← این ستون‌ها رو باریک میکنه
                categoryPercentage: 0.6    // ← این فاصله بین دسته‌ها رو تنظیم میکنه
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    bodyFont: {
                        family: 'IRANSans, Vazirmatn, sans-serif'
                    },
                    titleFont: {
                        family: 'IRANSans, Vazirmatn, sans-serif'
                    }
                }
            },
            scales: {
                x: {
                    ticks: {
                        font: {
                            family: 'IRANSans, Vazirmatn, sans-serif',
                            size: 12
                        }
                    },
                    grid: {
                        display: false
                    }
                },
                y: {
                    beginAtZero: true,
                    ticks: {
                        font: {
                            family: 'IRANSans, Vazirmatn, sans-serif',
                            size: 12
                        }
                    },
                    grid: {
                        color: 'rgba(255,255,255,0.06)'
                    }
                }
            }
        }
    });
</script>


</body>
</html>
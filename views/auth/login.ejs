<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>وارد شوید - منتورا</title>
    <link rel="stylesheet" href="/css/login.css" />
    <link rel="stylesheet" href="/fonts/font-awesome.min.css" />
</head>
<body>
    <section class="container">
        <form id="loginForm" class="form">
            <div class="form-content">
                
                <div class="form-logo">
                    <i class="fa fa-user-circle"></i>
                </div>
                
                <header>
                    <p class="welcome">خوش آمدید !</p>
                    <div class="go-register-text">
                        <p>حساب کاربری ندارید؟</p>
                        <a href="/auth/register/">ثبت نام کنید !</a>
                    </div>

                    <div class="login-methods">
                        <div>
                            <a href="/auth/google" style="display: flex; align-items: center; justify-content: center; gap: 12px; text-decoration: none; color: #333; width: 100%; height: 100%; cursor: pointer; position: relative; z-index: 10;">
                                <img src="/img/google.png" alt="google" class="login-logo" style="width: 24px; height: auto; pointer-events: none;">
                                ورود با گوگل
                            </a>
                        </div>
                    </div>
                </header>
                
                <main class="form-main">
                    <p class="or">یا وارد شوید با :</p>

                    <div class="inputs-container">
                        <div class="input-wrapper">
                            <i class="fa fa-user"></i>
                            <input class="form-input" name="username" type="text" placeholder="نام کاربری ..." autocomplete="username" required />
                        </div>
                        
                        <div class="input-wrapper">
                            <i class="fa fa-lock"></i>
                            <input class="form-input make-ltr" name="password" type="password" placeholder="گذرواژه ..." autocomplete="current-password" required />
                        </div>
                        
                        <div class="input-wrapper">
                            <i class="fa fa-shield"></i>
                            <input type="text" name="captcha" placeholder="متن داخل عکس را وارد کنید ..." required />
                        </div>
                        
                        <input type="hidden" class="uuid" name="uuid" />
                        
                        <div class="captcha-wrapper">
                            <div class="captcha"></div>
                        </div>
                    </div>
                    
                    <div class="remember-me">
                        <input type="checkbox" name="remember-me" id="remember-me" />
                        <label for="remember-me">مرا به خاطر بسپار</label>
                    </div>
                </main>
                
                <footer class="form-footer">
                    <button type="submit" class="login-button">
                        <i class="fa fa-sign-in"></i> وارد شوید
                    </button>
                    
                    <div class="forgot-password">
                        <a href="/auth/forgot-password">رمز عبور خود را فراموش کرده‌اید؟</a>
                    </div>
                </footer>
            </div>
        </form>
    </section>
    
    <script src="/js/sweetAlert2.js"></script>
    
    <script>

    (async function () {
        const captcha = document.querySelector(".captcha");
        const uuid = document.querySelector(".uuid");

        try {
            const res = await fetch("/captcha");
            const response = await res.json();
            uuid.value = response.uuid;
            captcha.innerHTML = response.captcha;
        } catch (error) {
            console.error("Error loading captcha:", error);
        }
    })();


    document.getElementById('loginForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        
        Swal.fire({
            title: 'در حال ورود...',
            allowOutsideClick: false,
            didOpen: () => Swal.showLoading()
        });
        
        try {
            const res = await fetch('/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    username: formData.get('username'),
                    password: formData.get('password'),
                    captcha: formData.get('captcha'),
                    uuid: formData.get('uuid')
                })
            });
            
            const data = await res.json();
            console.log('Login Response:', data);
            
            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'ورود موفق! 🎉',
                    text: data.message || 'در حال انتقال...',
                    timer: 2000,
                    showConfirmButton: false
                }).then(() => {
                    window.location.href = '/';
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'خطا',
                    text: data.error || 'مشکلی پیش آمد',
                    confirmButtonText: 'تلاش مجدد',
                    confirmButtonColor: '#667eea'
                });
                

                const captchaRes = await fetch("/captcha");
                const captchaData = await captchaRes.json();
                document.querySelector(".uuid").value = captchaData.uuid;
                document.querySelector(".captcha").innerHTML = captchaData.captcha;
            }
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'خطا',
                text: 'خطا در ارتباط با سرور',
                confirmButtonText: 'باشه'
            });
        }
    });
    </script>

    <style>
        .swal-title { font-family: "IranSans-Bold" !important; }
        .swal-text { font-family: "IranSans-Regular" !important; }
        .swal2-confirm { font-family: "IranSans-Bold" !important; }
    </style>
</body>
</html>